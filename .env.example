# PostgreSQL connection strings
# For Supabase / connection pooling:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Remix session secret (for auth sessions)
SESSION_SECRET="super-secret-session-key-at-least-32-chars-long"

# Admin user credentials for seeding (optional)
ADMIN_EMAIL="admin@brandit.test"
ADMIN_PASSWORD="super-admin-password-123"

